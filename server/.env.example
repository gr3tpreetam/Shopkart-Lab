# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
